<window title="SunPack" width="1120" height="720" min-width="850" min-height="560" centered="true" frameless="false"/>
<script>
// Weak keys let snapshots/filter changes release their old row index. Values
// reference the existing rows; no second projection or resident row copy.
const taskIndexes=new WeakMap();
function taskBefore(a,b) {
  return a.sortTimestamp>b.sortTimestamp ||
    (a.sortTimestamp===b.sortTimestamp && a.sortSequence>b.sortSequence);
}
function taskPosition(rows,row) {
  let lo=0,hi=rows.length;
  while(lo<hi) { let mid=(lo+hi)>>>1; if(taskBefore(rows[mid],row)) lo=mid+1; else hi=mid; }
  return lo;
}
export default {
  data() { return {
    tab:'tasks',theme:'system',themeChoice:0,appearance:'light',language:'en',texts:{},dispatch:false,requests:[],ready:false,busy:false,
    actionError:'',lastCommand:{},errors:{},logPath:'',cliAllowed:false,runtime:{known:false,running:false},
    tasks:{rows:[],total:0,malformed:0},passwords:{rows:[],total:0},fields:[],directories:[],
    startup:{enabled:false,command:''},directoryQuery:'',
    taskQuery:'',taskRoot:'',taskStatus:0,
    statusNames:['','taskProcessing','taskWaiting','taskSucceeded','taskFailed'],
    rootEditor:false,rootOriginal:'',rootInput:'',rootPaths:[],rootOutput:'',rootDeep:false,
    configCategory:'',configQuery:'',drafts:{},toggleDrafts:{},saving:false,saveErrors:{},closeError:'',pendingFields:[],recordSaving:{passwords:false,roots:false},rootSession:0,passwordSession:0,rootBaseline:'',rootExpected:null,passwordBaseline:'',
    passwordScope:'@all',passwordQuery:'',passwordOriginal:'',passwordValue:'',scopePaths:[],scopeGlobal:true,passwordValues:[],passwordEditor:false,
    listTarget:'',listTitle:'',listField:null,listRows:[],listNext:0,listQuery:'',listEntry:'',listEditing:-1,listMultiline:false,listImport:false,listImportText:'',listPreview:[],listError:''
  }; },
  computed: {
    rootDirty() { return this.rootEditor&&JSON.stringify({input:this.rootInput,output:this.rootOutput,deep:this.rootDeep,paths:this.rootPaths})!==this.rootBaseline; },
    passwordDirty() { return this.passwordEditor&&JSON.stringify({value:this.passwordValue,scopes:this.scopePaths,global:this.scopeGlobal,values:this.passwordValues})!==this.passwordBaseline; },
    matchingListRows() { let q=this.listQuery.toLowerCase(); return this.listRows.filter(r=>r.value.toLowerCase().indexOf(q)>=0); },
    errorList() { return Object.keys(this.errors).map(k=>k+': '+this.errors[k]); },
    shownDirectories() { let q=this.directoryQuery.toLowerCase(); return this.directories.filter(d=>d.watch&&d.path.toLowerCase().indexOf(q)>=0); },
    shownPasswords() { return this.passwordEditor&&this.passwordOriginal&&this.passwordScope==='@all'?this.passwords.rows.filter(p=>p.original!==this.passwordOriginal):this.passwords.rows; },
    chosenDirectory() { return this.directories.find(d=>d.watch&&d.path===this.taskRoot)||{path:'',effectiveOutput:''}; },
    categories() { let seen={}; return this.fields.filter(f=>{ if(seen[f.category]) return false; seen[f.category]=true; return true; }).map(f=>({id:f.category,label:f.categoryLabel})); },
    configBlocks() {
      let groups=[],seen={};
      this.fields.forEach(f=>{
        let g=seen[f.block];
        if(!g) { g={id:f.block,key:f.key,label:f.blockLabel,module:f.module,category:f.category,fields:[],primary:false}; seen[f.block]=g; groups.push(g); }
        if(f.primary) { g.fields.unshift(f); g.primary=true; } else g.fields.push(f);
      });
      return groups;
    },
    matchingBlocks() { let q=this.configQuery.toLowerCase(); return this.configBlocks.filter(g=>(!this.configCategory||g.category===this.configCategory)&&(!q||(g.label+' '+g.module+' '+g.fields.map(f=>f.label+' '+f.description+' '+f.id).join(' ')).toLowerCase().indexOf(q)>=0)); },
  },
  methods: {
    send(op,payload) {
      if(op==='cli') { if(this.busy) return; this.busy=true; this.actionError=''; }
      let requests=op==='filterTasks'||op==='filterPasswords'?this.requests.filter(r=>r.op!==op):this.requests;
      this.requests=requests.concat([{op:op,payload:payload||{}}]); this.dispatch=true;
    },
    go(tab) { if(this.listTarget) { this.closeError=this.texts.unsavedEntries; return; } this.send('navigate',{tab:tab}); },
    selectCategory(category) { if(this.configCategory===category) return; this.configCategory=category; this.send('animateView',{id:'configBlocks'}); },
    searchDirectory(value) { this.directoryQuery=value; this.send('scrollTop',{id:'directoryItems'}); },
    searchConfig(value) { this.configQuery=value; this.send('scrollTop',{id:'configBlocks'}); },
    searchTasks(value) { this.taskQuery=value; this.filterTasks(); },
    applyTaskDelta(patch) {
      if(!patch.changes.length) {
        if(this.tasks.malformed!==patch.malformed)
          this.tasks={rows:this.tasks.rows,total:this.tasks.total,malformed:patch.malformed};
        return;
      }
      let rows=this.tasks.rows,index=taskIndexes.get(rows);
      if(!index) { index=new Map(); for(let row of rows) index.set(row.id,row); taskIndexes.set(rows,index); }
      let updates=new Map(),order=0;
      for(let change of patch.changes) {
        updates.delete(change.id); // iteration order follows the final event
        updates.set(change.id,{row:change.row||null,order:order++});
      }
      // Small deltas touch only changed rows. The index holds row references,
      // so moving a row never requires rebuilding thousands of ID positions.
      if(updates.size<=32) {
        let copied=false;
        updates.forEach((update,id)=>{
          let old=index.get(id),next=update.row;
          if(old) {
            let pos=taskPosition(rows,old);
            while(pos<rows.length && rows[pos]!==old) ++pos; // equal sort keys
            if(next && (pos===0 || taskBefore(rows[pos-1],next)) &&
               (pos+1===rows.length || !taskBefore(rows[pos+1],next))) {
              rows[pos]=next; index.set(id,next); return;
            }
            if(!copied) { rows=rows.slice(); copied=true; }
            rows.splice(pos,1); index.delete(id);
          }
          if(next) {
            if(!copied) { rows=rows.slice(); copied=true; }
            rows.splice(taskPosition(rows,next),0,next); index.set(id,next);
          }
        });
        // core-ui observes the top-level state write; keep untouched row
        // objects, then notify bindings once per batch. A positional change
        // gets a new array so VirtualList also invalidates measured heights.
        if(copied) taskIndexes.set(rows,index);
        this.tasks={rows:rows,total:rows.length,malformed:patch.malformed};
        return;
      }
      // Large batches use a linear merge instead of shifting the list once
      // per change.
      rows=rows.filter(row=>!updates.has(row.id));
      let added=[];
      updates.forEach((update,id)=>{ index.delete(id); if(update.row) { added.push(update); index.set(id,update.row); } });
      added.sort((a,b)=>{
        if(a.row.sortTimestamp!==b.row.sortTimestamp) return a.row.sortTimestamp>b.row.sortTimestamp?-1:1;
        if(a.row.sortSequence!==b.row.sortSequence) return a.row.sortSequence>b.row.sortSequence?-1:1;
        return b.order-a.order;
      });
      let merged=[],i=0,j=0;
      while(i<rows.length&&j<added.length) {
        let old=rows[i],next=added[j].row;
        let oldBefore=old.sortTimestamp>next.sortTimestamp ||
          (old.sortTimestamp===next.sortTimestamp && old.sortSequence>next.sortSequence);
        if(oldBefore) merged.push(rows[i++]); else merged.push(added[j++].row);
      }
      while(i<rows.length) merged.push(rows[i++]);
      while(j<added.length) merged.push(added[j++].row);
      taskIndexes.set(merged,index);
      this.tasks={rows:merged,total:merged.length,malformed:patch.malformed};
    },
    applyPasswordDelta(patch) {
      // The writer already committed a verified replacement. Keep the rest of
      // the saved-password list (and its mounted virtual rows) intact.
      let rows=this.passwords.rows.slice();
      let i=rows.findIndex(row=>row.original===patch.original);
      if(i<0) { this.filterPasswords(); return; } // Recover from stale UI state.
      let replacement=patch.row;
      replacement.id=replacement.original+'#'+i;
      rows[i]=replacement;
      this.passwords={rows:rows,total:rows.length};
    },
    searchPasswords(value) { this.passwordQuery=value; this.filterPasswords(); },
    filterTasks() { this.send('filterTasks',{query:this.taskQuery,root:this.taskRoot,status:this.statusNames[this.taskStatus]||''}); },
    selectRoot(path) { if(this.rootDirty) { this.setSaveError('@roots','unsavedEntries'); return; } if(this.rootEditor) this.leaveRoot(); this.taskRoot=path; this.filterTasks(); },
    filterPasswords() { this.send('filterPasswords',{query:this.passwordQuery,scope:this.passwordScope}); },
    selectScope(path) { if(this.recordSaving.passwords) return; if(this.passwordDirty) { this.setSaveError('@passwords','unsavedEntries'); return; } this.leavePassword(); this.passwordScope=path; this.filterPasswords(); },
    rootState(d) { let input=d?d.path:'',output=d?d.output:'',deep=d?d.deep:false; return {rootSession:this.rootSession+1,rootOriginal:input,rootInput:input,rootPaths:[],rootOutput:output,rootDeep:deep,rootExpected:d?{output:output,deep:deep}:null,rootBaseline:JSON.stringify({input:input,output:output,deep:deep,paths:[]}),rootEditor:true}; },
    editRoot(d) { if(this.recordSaving.roots) return; if(this.rootDirty) { this.setSaveError('@roots','unsavedEntries'); return; } Object.assign(this,this.rootState(d)); this.send('revealForm',{kind:'root'}); },
    deleteListedRoot(d) {
      if(this.recordSaving.roots) return;
      if(this.rootOriginal===d.path) { this.rootAction('delete'); return; }
      this.send('saveRecord',{kind:'roots',key:'delete:'+d.id,edit:{operation:'delete',original:d.path,input:d.path,output:d.output,deep:d.deep,expected:{output:d.output,deep:d.deep}}});
    },
    rootEdit(operation) {
      let edit={operation:operation,original:this.rootOriginal,input:this.rootInput,output:this.rootOutput,deep:this.rootDeep,expected:this.rootExpected};
      if(operation==='save'&&!this.rootOriginal) { edit.operation='addMany'; edit.inputs=this.rootPaths.concat(this.rootInput.trim()?[this.rootInput.trim()]:[]); if(!edit.inputs.length) throw new Error('rootsEmpty'); }
      return edit;
    },
    errorText(error) { return error && typeof error==='object' ? error.text : (this.texts[error]||error); },
    setSaveError(key,message) { let errors=Object.assign({},this.saveErrors); if(message) errors[key]=message; else delete errors[key]; this.saveErrors=errors; },
    leaveRoot() { this.rootSession++; this.rootEditor=false; this.rootOriginal=''; this.rootInput=''; this.rootPaths=[]; this.rootOutput=''; this.rootBaseline=''; this.rootExpected=null; this.setSaveError('@roots',''); this.closeError=''; },
    rootAction(operation,nextState) {
      if(!this.rootOriginal&&this.recordSaving.roots) return;
      if(operation==='save'&&!this.rootDirty&&!this.recordSaving.roots) { Object.assign(this,nextState||{rootEditor:false}); return; }
      try {
        let edit=this.rootEdit(operation),snapshot={input:this.rootInput,output:this.rootOutput,deep:this.rootDeep,paths:this.rootPaths};
        this.setSaveError('@roots','');
        this.send('saveRecord',{kind:'roots',key:this.rootSession,edit:edit,snapshot:snapshot,nextState:nextState||{rootEditor:false}});
      } catch(e) { this.setSaveError('@roots',e.message); }
    },
    commitField(f) {
      let draft=this.drafts[f.id]||this.toggleDrafts[f.id];
      if(draft) this.send('saveField',{id:f.id,draft:Object.assign({},draft)});
    },
    changeField(f,value) {
      f=this.fields.find(current=>current.id===f.id)||f;
      let d=this.drafts[f.id]||{original:f.original,text:f.text,boolean:f.boolean,choice:f.choice,baselineText:f.text,baselineBoolean:f.boolean};
      if(this.saveErrors[f.id]&&this.pendingFields.indexOf(f.id)<0) { d.original=f.original; d.baselineText=f.text; d.baselineBoolean=f.boolean; }
      d.text=value;
      let next=Object.assign({},this.drafts);
      if(d.text===d.baselineText&&this.pendingFields.indexOf(f.id)<0) delete next[f.id]; else next[f.id]=d;
      this.drafts=next; this.setSaveError(f.id,'');
    },
    passwordState(p) { let original=p?p.original:'',value=p?p.value:'',scopes=p?p.scopePaths:[]; return {passwordSession:this.passwordSession+1,passwordOriginal:original,passwordValue:value,scopePaths:scopes,scopeGlobal:scopes.length===0,passwordValues:[],passwordBaseline:JSON.stringify({value:value,scopes:scopes,global:scopes.length===0,values:[]}),passwordEditor:true}; },
    editPassword(p) { if(this.recordSaving.passwords) return; if(this.passwordDirty) { this.setSaveError('@passwords','unsavedEntries'); return; } let next=this.passwordState(p); if(!next.passwordOriginal) next.passwordScope='@all'; let changed=next.passwordScope && this.passwordScope!==next.passwordScope; Object.assign(this,next); if(changed) this.filterPasswords(); this.send('revealForm',{kind:'password'}); },
    deleteListedPassword(p) {
      if(this.recordSaving.passwords) return;
      if(this.passwordOriginal===p.original) { this.passwordAction('delete'); return; }
      this.send('saveRecord',{kind:'passwords',key:'delete:'+p.id,edit:{operation:'delete',original:p.original}});
    },
    passwordEdit(operation) {
      let scopes=this.scopeGlobal?[]:this.scopePaths;
      if(operation==='save'&&!this.scopeGlobal&&scopes.length===0) throw new Error('scopeRequired');
      let values=this.passwordValues.concat(this.passwordValue.length?[this.passwordValue]:[]);
      if(!this.passwordOriginal&&operation==='save'&&values.length===0) throw new Error('batchEmpty');
      return {operation:operation==='save'?(this.passwordOriginal?'replace':'addMany'):operation,
        original:this.passwordOriginal,value:this.passwordValue,values:values,scopes:scopes};
    },
    leavePassword() { this.passwordSession++; this.passwordEditor=false; this.passwordOriginal=''; this.passwordValue=''; this.scopePaths=[]; this.passwordValues=[]; this.passwordBaseline=''; this.setSaveError('@passwords',''); this.closeError=''; },
    passwordAction(operation,nextState) {
      if(!this.passwordOriginal&&this.recordSaving.passwords) return;
      if(operation==='save'&&!this.passwordDirty&&!this.recordSaving.passwords) { Object.assign(this,nextState||{passwordEditor:false}); return; }
      try {
        let edit=this.passwordEdit(operation),snapshot={value:this.passwordValue,scopes:this.scopePaths,global:this.scopeGlobal,values:this.passwordValues};
        this.setSaveError('@passwords','');
        this.send('saveRecord',{kind:'passwords',key:this.passwordSession,edit:edit,snapshot:snapshot,nextState:nextState||{passwordEditor:false}});
      } catch(e) { this.setSaveError('@passwords',e.message); }
    },
    listCount(values) { return values.length+' '+this.texts.entries; },
    entryLabel(value) { return value.length?value.replace(/\r/g,'␍').replace(/\n/g,'↵'):this.texts.emptyEntry; },
    listSummary(values) { return values.slice(0,3).map(v=>{let s=this.entryLabel(v);return s.length>60?s.slice(0,60)+'…':s;}).join(' · ')+(values.length>3?' …':''); },
    searchList(value) { this.listQuery=value; this.send('scrollTop',{id:'listItems'}); },
    rebaseListField(saved) {
      if(this.listField&&this.listField.id===saved.id&&this.listField.original===saved.previous)
        this.listField=Object.assign({},this.listField,{original:saved.original,text:saved.text});
    },
    openList(target,field) {
      if(field) field=this.fields.find(current=>current.id===field.id)||field;
      let values=target==='config'?(this.drafts[field.id]?JSON.parse(this.drafts[field.id].text):field.items):this[target];
      this.listField=field?Object.assign({},field):null;
      this.listTitle=field?field.label:target==='rootPaths'?this.texts.roots:target==='scopePaths'?this.texts.scopeLabel:this.texts.passwords;
      this.listRows=values.map((value,id)=>({id:id,value:value})); this.listNext=values.length;
      this.listQuery=''; this.listEntry=''; this.listEditing=-1; this.listMultiline=false; this.listImport=false; this.listImportText=''; this.listPreview=[]; this.listError=''; this.listTarget=target;
    },
    closeList() { this.listTarget=''; this.listRows=[]; this.listField=null; this.listTitle=''; this.listQuery=''; this.listEntry=''; this.listImportText=''; this.listPreview=[]; this.listError=''; this.closeError=''; },
    editListRow(row) { this.listEditing=row.id; this.listEntry=row.value; this.listMultiline=/[\r\n]/.test(row.value); },
    putListEntry() {
      let value=this.listEntry;
      if(this.listTarget==='rootPaths'||this.listTarget==='scopePaths') { value=value.trim(); if(!value||/[\r\n]/.test(value)) {this.listError=this.texts.folderEntryRequired;return false;} }
      if(this.listTarget==='passwordValues'&&!value.length) {this.listError=this.texts.batchEmpty;return false;}
      if(this.listEditing<0) this.listRows=this.listRows.concat([{id:this.listNext++,value:value}]);
      else this.listRows=this.listRows.map(r=>r.id===this.listEditing?{id:r.id,value:value}:r);
      this.listEntry=''; this.listEditing=-1; this.listMultiline=false; this.listError=''; return true;
    },
    removeListRow(id) { this.listRows=this.listRows.filter(r=>r.id!==id); if(this.listEditing===id) {this.listEditing=-1;this.listEntry='';} },
    previewImport() {
      // Line parsing is confined to this explicit import boundary. Password
      // whitespace is significant; blank lines are intentionally skipped.
      let paths=this.listTarget==='rootPaths'||this.listTarget==='scopePaths';
      this.listPreview=this.listImportText.split(/\r\n|\n|\r/).map(v=>paths?v.trim():v).filter(v=>v.length>0).map((value,id)=>({id:id,value:value}));
    },
    applyImport() { let next=this.listNext,rows=this.listPreview.map(r=>({id:next++,value:r.value})); this.listNext=next; this.listRows=this.listRows.concat(rows); this.listImport=false; this.listImportText=''; this.listPreview=[]; this.listError=''; },
    saveList() {
      if(this.listImportText.length) {this.listError=this.texts.finishImport;return;}
      if((this.listEntry.length||this.listEditing>=0)&&!this.putListEntry()) return;
      let values=this.listRows.map(r=>r.value);
      if(this.listTarget==='config') {
        let f=this.listField,draft={original:f.original,text:JSON.stringify(values),boolean:f.boolean,baselineText:f.text,baselineBoolean:f.boolean};
        this.drafts=Object.assign({},this.drafts,{[f.id]:draft}); this.commitField(f);
      } else this[this.listTarget]=values;
      this.closeList();
    }

  }
}
</script>
<style>
  .app { flex:1; gap:0px; color:var(--fg); font-size:14px; }
  .light { background:#f3f3f3; }
  .dark { background:#202020; }
  label { display:block; }
  .navigation { width:280px; flex-shrink:0; padding:16px 12px 8px; gap:4px; }
  .identity { flex-direction:row; align-items:center; gap:12px; padding:0px 4px 8px; flex-shrink:0; }
  .monitor-controls { gap:8px; padding:0px 4px 8px; flex-shrink:0; }
  .monitor-actions button { flex:1; }
  .app-icon { width:40px; height:40px; flex-shrink:0; }
  .brand { font-size:20px; font-weight:600; }
  .nav-item { display:flex; width:100%; flex-direction:row; align-items:center; height:40px; padding:0px 4px; gap:12px; border:0px; border-radius:4px; background:#00000001; color:var(--fg); }
  .light .nav-item:hover { background:#ebebeb; }
  .dark .nav-item:hover { background:#2d2d2d; }
  .light .on { background:#e6e6e6; color:var(--fg); }
  .dark .on { background:#363636; color:var(--fg); }
  .nav-icon { width:18px; height:18px; color:var(--fg); }
  .nav-mark { width:3px; height:16px; }
  /* Three 40 px entries and two gaps; the overlaid selection indicator
     must not reserve an additional row below the navigation. */
  .nav-items { height:128px; gap:4px; flex-shrink:0; }
  .nav-indicator { position:absolute; left:4px; top:12px; width:3px; height:16px; border-radius:2px; background:var(--accent-text); }
  .light .nav-indicator { background:#0067c0; }
  .dark .nav-indicator { background:#60cdff; }
  .spacer { flex:1; }
  .body { flex:1; flex-direction:row; }
  .sidebar { flex:1; padding:20px 8px 0px; gap:8px; }
  .sidebar-heading { font-size:12px; color:var(--fg-2); padding:0px 4px 4px; }
  .sidebar button { min-height:32px; }
  .context-item { display:flex; width:100%; flex-direction:row; align-items:center; padding:7px 12px; gap:10px; border:0px; background:#00000001; color:var(--fg); }
  .context-item:hover { background:var(--sidebar-hover); }
  .content { flex:1; padding:24px 28px 24px; gap:16px; }
  .workspace { flex:1; gap:12px; }
  .page-header { flex-direction:row; flex-wrap:wrap; align-items:center; gap:12px; padding-bottom:4px; }
  .row { flex-direction:row; align-items:center; gap:8px; }
  .column { gap:8px; }
  .fill { flex:1; }
  .heading { font-size:28px; font-weight:600; }
  .subheading { font-size:14px; font-weight:600; }
  .muted { color:var(--fg-2); font-size:12px; }
  .small { font-size:12px; }
  .directory-pane { flex:1; padding:8px 4px 4px; gap:4px; }
  .directory-tools { gap:8px; flex-shrink:0; }
  .directory-tools > button { width:100%; flex-shrink:0; }
  .directory-tools > input { width:100%; }
  .directory-list { gap:2px; }
  .directory-list > button { width:100%; flex-shrink:0; }
  .directory-item { min-height:52px; padding:8px 12px; flex-shrink:0; }
  .directory-item .column { gap:2px; }
  .directory-name, .directory-path { white-space:nowrap; }
  .directory-actions button { flex:1; flex-shrink:0; }
  .selected-directory { font-size:12px; color:var(--fg-2); }
  .search-field { placeholder-color:var(--fg-2); }
  .task-filters { flex-wrap:wrap; }
  .task-filters input { min-width:180px; }
  .card { padding:16px 20px; gap:10px; border:1px solid var(--card-border); border-radius:8px; }
  .settings-row { flex-direction:row; align-items:center; gap:16px; }
  .setting-copy { flex:1; gap:4px; }
  .setting-copy > label { width:100%; flex-shrink:0; }
  .setting-title { font-size:14px; }
  .task { padding:10px 14px; gap:4px; border:1px solid var(--card-border); border-radius:8px; }
  .taskname { flex-shrink:1; background:#00000001; padding:0px; min-height:24px; border:0px; color:var(--fg); font-size:14px; font-weight:600; text-align:left; }
  .light .taskname:hover { color:#0067c0; }
  .dark .taskname:hover { color:#60cdff; }
  .task-meta { align-items:flex-end; }
  .task-meta .time { flex-shrink:0; white-space:nowrap; }
  .status { font-size:14px; font-weight:600; padding:4px 10px; border-radius:4px; flex-shrink:0; white-space:nowrap; }
  .light .status-success { color:#0f6b35; background:#dff6dd; }
  .dark .status-success { color:#6ccb5f; background:#263c28; }
  .light .status-waiting { color:#7a4e00; background:#fff4ce; }
  .dark .status-waiting { color:#fce100; background:#433d24; }
  .light .status-failure { color:#a4262c; background:#fde7e9; }
  .dark .status-failure { color:#ff99a4; background:#442726; }
  .light .status-info { color:#005a9e; background:#e5f1fb; }
  .dark .status-info { color:#75b6e7; background:#243b50; }
  .time { color:var(--fg-2); font-size:12px; }
  .error { color:#d15b48; font-size:12px; width:100%; flex-shrink:0; }
  .light .card, .task.light, .card.light { background:#fbfbfb; border:1px solid #e5e5e5; }
  .dark .card, .task.dark, .card.dark { background:#2b2b2b; border:1px solid #303030; }
  /* Actions keep their intrinsic text width even when a scrollbar appears.
     Flexible text/inputs yield space; action rows wrap instead of shrinking. */
  button { padding:6px 12px; border-radius:4px; min-height:32px; flex-shrink:0; cursor:pointer; }
  toggle { flex-shrink:0; }
  .action-row { flex-direction:row; flex-wrap:wrap; align-items:center; gap:8px; }
  .input-row { flex-direction:row; flex-wrap:wrap; align-items:center; gap:8px; }
  .input-row input { min-width:140px; }
  .inline-form { flex-shrink:0; }
  .scope-value { white-space:pre-wrap; }
  .password-toolbar { flex-direction:row; flex-wrap:wrap; align-items:center; gap:16px; }
  .password-tabs { flex-direction:row; flex-wrap:wrap; align-items:center; gap:8px; }
  .password-search { width:220px; flex-shrink:0; }
  input, select { height:32px; }
  .content > input, .sidebar > input, .inline-form textarea { display:block; width:100%; }
  textarea { min-height:90px; }
  /* Core UI scrollbars overlay the viewport (up to 9 px plus a 2 px
     inset). Reserve 18 px for the bar and shadows in every scroll pane. */
  ScrollView { flex:1; padding:2px 18px 6px 2px; }
  .setting-control { width:220px; gap:8px; }
  .setting-control input, .setting-control textarea { width:100%; }
  .toggle-host { height:26px; align-items:flex-end; }
  .setting-card { padding:16px 20px; gap:10px; border:1px solid var(--card-border); border-radius:8px; }
  .setting-card.light { background:#fbfbfb; border:1px solid #e5e5e5; }
  .setting-card.dark { background:#2b2b2b; border:1px solid #303030; }
  .setting-card { gap:0px; padding:0px 20px; }
  .block-fields { gap:0px; }
  .setting-item { padding:16px 0px; gap:10px; }
  .setting-item > textarea { width:100%; }
  .setting-divider { height:1px; background:var(--card-border); }
  .block-heading { padding:16px 0px 0px; font-size:14px; font-weight:600; }
  .runtime-badge { width:92px; flex-direction:row; align-items:center; gap:7px; flex-shrink:0; }
  .runtime-dot { width:8px; height:8px; border-radius:4px; background:#8a8a8a; flex-shrink:0; }
  .runtime-dot.running { background:#6ccb5f; }
  .setting-description { color:var(--fg-2); font-size:12px; }
  .choice-host { height:32px; flex-direction:row; }
  .list-manager { flex:1; padding:20px; gap:12px; }
  .light .list-manager { background:#f3f3f3; }
  .dark .list-manager { background:#202020; }
  .list-row { min-height:44px; padding:6px 0px; flex-direction:row; align-items:center; gap:8px; }
  .list-value { flex:1; white-space:pre-wrap; }
  .collection-preview { white-space:nowrap; }
  .list-import { flex:1; gap:10px; }
  #listEntry, #listMultiline, #listImportText, #passwordValue { width:100%; }
  .history-list { gap:0px; border:1px solid var(--card-border); border-radius:8px; padding:0px 12px; }
  .history-list.light { background:#fbfbfb; }
  .history-list.dark { background:#2b2b2b; }
  .history-entry { gap:0px; }
  .scope-value { padding:2px 0px 0px; }
  .history-row { flex-direction:row; align-items:center; gap:12px; padding:4px 0px; min-height:40px; }
  .password-row { padding:12px 0px; }
  .password-copy { flex:1; gap:0px; }
  .history-copy { width:132px; }
  .history-divider { height:1px; background:var(--card-border); }
  .nav-item { transition:background-color 140ms ease-out; }
</style>
<template>
  <div :class="'app '+appearance">
    <div class="body">
      <div id="navigation" class="navigation" :enabled="!listTarget">
        <div id="identity" class="identity">
          <img id="appIcon" class="app-icon" src="sunpack.png" width="40" height="40" object-fit="contain"/>
          <div id="brand" class="column fill" style="gap:3px"><label class="brand">SunPack</label><label class="muted">{{ texts.manager }}</label></div>
          <div id="runtimeStatus" class="runtime-badge"><div :class="runtime.known &amp;&amp; runtime.running?'runtime-dot running':'runtime-dot'"/><label class="muted">{{ !runtime.known?texts.runtimeUnknown:runtime.running?texts.runtimeRunning:texts.runtimeStopped }}</label></div>
        </div>
        <div id="monitorControls" class="monitor-controls">
          <div class="row monitor-actions"><button id="watchStart" :enabled="cliAllowed" @click="send('cli',{action:'start'})">{{ texts.startWatch }}</button><button id="watchStop" :enabled="cliAllowed" @click="send('cli',{action:'stop'})">{{ texts.stopWatch }}</button></div>
          <label v-show="actionError" class="error">{{ errorText(actionError) }}</label>
        </div>
      <div id="navItems" class="nav-items">
        <button id="tabTasks" :class="tab==='tasks'?'nav-item on':'nav-item'" @click="go('tasks')">
          <div class="nav-mark"/>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none"><path d="m3 6 1.5 1.5L7 5M10 6h11M3 12l1.5 1.5L7 11M10 12h11M3 18l1.5 1.5L7 17M10 18h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><label>{{ texts.tasks }}</label>
        </button>
        <button id="tabConfig" :class="tab==='config'?'nav-item on':'nav-item'" @click="go('config')">
          <div class="nav-mark"/>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 17h16M8 4v6M16 14v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><label>{{ texts.config }}</label>
        </button>
        <button id="tabPasswords" :class="tab==='passwords'?'nav-item on':'nav-item'" @click="go('passwords')">
          <div class="nav-mark"/>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none"><path d="M14 5a5 5 0 1 1-2 8l-7 7H2v-3l7-7a5 5 0 0 1 5-5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><label>{{ texts.passwords }}</label>
        </button>
        <div id="navIndicator" class="nav-indicator"/>
      </div>
      <div v-show="tab==='config'" class="sidebar">
        <label class="sidebar-heading">{{ texts.categories }}</label>
        <button :class="!configCategory?'context-item on':'context-item'" @click="selectCategory('')"><label>{{ texts.allSettings }}</label></button>
        <ScrollView id="categoryScroll"><div class="column"><button v-for="c in categories" :key="c.id" :id="'category-'+c.id" :class="configCategory===c.id?'context-item on':'context-item'" @click="selectCategory(c.id)"><label>{{ c.label }}</label></button></div></ScrollView>
      </div>
      <div id="directoryPane" v-show="tab==='tasks'" class="directory-pane">
        <div class="directory-tools">
        <div class="row"><label class="subheading fill">{{ texts.roots }}</label><button id="newRoot" @click="editRoot(null)">{{ texts.addRoot }}</button></div>
        <input id="directorySearch" type="search" class="search-field" :placeholder="texts.searchDirectory" :value="directoryQuery" @input="searchDirectory"/>
        <button id="allRoots" :class="!taskRoot?'context-item on':'context-item'" @click="selectRoot('')"><label>{{ texts.allDirectories }}</label></button>
        </div>
        <ScrollView id="directoryListScroll"><VirtualList id="directoryItems" class="directory-list" estimated-height="60px">
          <button v-for="d in shownDirectories" :key="d.id" :id="'directory-'+d.id" class="context-item directory-item" :class="taskRoot===d.path?'on':''" @click="selectRoot(d.path)">
            <div class="column fill"><label class="directory-name">{{ d.name||d.path }}</label><label class="muted directory-path">{{ d.path }}</label></div>
          </button>
        </VirtualList></ScrollView>
        <div v-show="tab==='tasks' &amp;&amp; chosenDirectory.path" class="row directory-actions"><button id="editSelectedRoot" @click="editRoot(chosenDirectory)">{{ texts.edit }}</button><button @click="send('openPath',{path:chosenDirectory.path})">{{ texts.open }}</button><button id="deleteSelectedRoot" :enabled="!recordSaving.roots" @click="deleteListedRoot(chosenDirectory)">{{ texts.delete }}</button></div>
      </div>
      <div v-show="tab==='passwords'" class="spacer"/>
      </div>
      <div class="workspace">
      <div id="page-tasks" v-show="tab==='tasks' &amp;&amp; !listTarget" class="content">
        <div class="page-header"><label class="heading">{{ texts.tasks }}</label></div>
        <label v-show="!rootEditor &amp;&amp; saveErrors['@roots']" class="error">{{ errorText(saveErrors['@roots']) }}</label>
        <label v-show="chosenDirectory.path &amp;&amp; !rootEditor" class="selected-directory">{{ chosenDirectory.path }}</label>
        <div v-show="!rootEditor" class="row task-filters"><input id="taskSearch" type="search" class="fill search-field" :placeholder="texts.taskSearch" :value="taskQuery" @input="searchTasks"/>
          <div id="taskStatusHost" style="width:180px;height:32px"/>
        </div>
        <ScrollView id="taskListScroll"><div id="taskBody" class="column">
        <div id="rootForm" v-show="rootEditor" class="card inline-form" :enabled="!!rootOriginal||!recordSaving.roots">
            <div class="row"><label class="subheading">{{ rootOriginal?texts.editRoot:texts.addRoot }}</label><div class="spacer"/><button id="closeRootEditor" @click="leaveRoot()">{{ texts.cancelEntries }}</button></div>
          <label class="muted">{{ texts.inputDirectory }}</label><div class="input-row"><input id="rootInput" class="fill" v-model="rootInput"/><button id="browseRoot" @click="send('browse',{target:'rootInput'})">{{ texts.chooseDirectory }}</button></div>
          <div v-show="!rootOriginal" class="column"><div class="action-row"><label>{{ listCount(rootPaths) }}</label><button id="manageRoots" @click="openList('rootPaths')">{{ texts.manageEntries }}</button></div><label class="muted collection-preview">{{ listSummary(rootPaths) }}</label><label class="muted">{{ texts.rootBatchHint }}</label></div>
          <label class="muted">{{ texts.rootOutput }}</label><div class="input-row"><input id="rootOutput" class="fill" v-model="rootOutput"/><button id="browseOutput" @click="send('browse',{target:'rootOutput'})">{{ texts.chooseOutput }}</button></div>
          <label v-show="saveErrors['@roots']" class="error">{{ errorText(saveErrors['@roots']) }}</label><div class="action-row"><toggle id="rootDeepToggle" :checked="rootDeep" @change="v=>rootDeep=v"/><label>{{ texts.deep }}</label><button id="finishRoot" @click="rootAction('save',rootOriginal?{}:null)">{{ rootOriginal?texts.saveEntries:texts.addToList }}</button><button v-show="rootOriginal" @click="rootAction('delete')">{{ texts.deleteRoot }}</button></div>
        </div>
          <VirtualList id="taskItems" class="column" estimated-height="68px" immutable-items="true"><div v-for="t in tasks.rows" :key="t.id" :id="'task-'+t.id" :class="'task '+appearance">
            <div class="row"><button :id="'taskName-'+t.id" class="taskname" @click="send('openTask',{task:t})">{{ t.name }}</button><div class="spacer"/><label class="status" :class="'status-'+t.statusTone">{{ t.statusText }}</label></div>
            <div class="row task-meta"><label :id="'taskRoot-'+t.id" class="muted fill">{{ t.partCount ? texts.identifiedParts.replace('{count}',t.partCount)+' · ' : '' }}{{ texts.taskFolder }}{{ t.directory }}</label><label class="time">{{ t.time }}</label></div>
          </div>
          </VirtualList>
        </div></ScrollView>
        <label v-show="tasks.malformed" class="error">{{ tasks.malformed }} {{ texts.invalidLogs }}</label>
      </div>
      <div id="page-config" v-show="tab==='config' &amp;&amp; !listTarget" class="content">
        <div class="page-header"><label class="heading">{{ texts.config }}</label></div>
        <input id="configSearch" type="search" class="search-field" :placeholder="texts.settingSearch" :value="configQuery" @input="searchConfig"/>
        <ScrollView id="configListScroll"><div id="configBlocks" class="column">
          <div v-show="!configCategory &amp;&amp; !configQuery" class="card settings-row">
            <div class="setting-copy"><label class="setting-title">{{ texts.startup }}</label><label class="muted">{{ texts.startupDescription }}</label></div>
            <button id="startupToggle" :enabled="cliAllowed" @click="send('cli',{action:startup.enabled?'startupDisable':'startupEnable'})">{{ startup.enabled?texts.startupOff:texts.startupOn }}</button>
          </div>
          <div v-show="!configCategory &amp;&amp; !configQuery" class="card settings-row"><div class="setting-copy"><label class="setting-title">{{ texts.theme }}</label><label class="muted">{{ texts.themeDescription }}</label></div><div id="themeHost" style="width:180px;height:32px"/></div>
          <VirtualList id="configItems" class="column" estimated-height="140px"><div v-for="g in matchingBlocks" :key="g.key" :id="'block-'+g.id" :class="'setting-card '+appearance">
            <label v-show="(g.fields.length>1||g.module) &amp;&amp; !g.primary" class="block-heading">{{ g.label }}</label>
            <!-- This Core UI version binds inner loops through a conditional
                 scope. Groups are always nonempty; visibility uses v-show. -->
            <div v-if="true" class="block-fields">
            <div v-for="f in g.fields" :key="f.key" :id="'field-'+f.id" class="setting-item">
            <div v-show="f.id!==g.fields[0].id" class="setting-divider"/>
            <div class="settings-row">
              <div class="setting-copy"><label :class="f.primary?'subheading':'setting-title'">{{ f.label }}</label><label v-show="f.description" class="setting-description">{{ f.description }}</label></div>
              <div class="setting-control">
                <div v-show="f.editor==='toggle'" :id="'toggle-host-'+f.id" class="toggle-host"/>
                <div v-show="f.editor==='choice'||f.editor==='recursive'" :id="'choice-'+f.id" class="choice-host"/>
                <input v-show="f.editor==='text'" :id="'input-'+f.id" :value="drafts[f.id]?drafts[f.id].text:f.text" @input="v=>changeField(f,v)" @blur="commitField(f)" @submit="commitField(f)"/>
                <div v-show="f.editor==='recursive' &amp;&amp; (drafts[f.id]?drafts[f.id].choice:f.choice)===2" class="column"><label class="muted">{{ texts.rounds }}</label><input :id="'rounds-'+f.id" :value="drafts[f.id]?drafts[f.id].text:f.text" @input="v=>changeField(f,v)" @blur="commitField(f)" @submit="commitField(f)"/></div>
                <label v-show="f.editor==='readonly'" class="muted">{{ texts.readOnly }}</label>
                <div v-show="f.editor==='list'" class="action-row"><label>{{ listCount(drafts[f.id]?JSON.parse(drafts[f.id].text):f.items) }}</label><button :id="'list-'+f.id" @click="openList('config',f)">{{ texts.manageEntries }}</button></div>
              </div>
            </div>
            <label v-show="f.editor==='list'" class="muted collection-preview">{{ listSummary(drafts[f.id]?JSON.parse(drafts[f.id].text):f.items) }}</label>
            <label v-show="saveErrors[f.id]" class="error">{{ errorText(saveErrors[f.id]) }}</label>
            </div>
            </div>
          </div>
          </VirtualList>
        </div></ScrollView>
      </div>
      <div id="page-passwords" v-show="tab==='passwords' &amp;&amp; !listTarget" class="content">
        <div class="page-header"><label class="heading">{{ texts.passwords }}</label></div>
        <label v-show="!passwordEditor &amp;&amp; saveErrors['@passwords']" class="error">{{ errorText(saveErrors['@passwords']) }}</label>
        <div class="password-toolbar"><input id="passwordSearch" type="search" class="search-field password-search" :placeholder="texts.passwordSearch" :value="passwordQuery" @input="searchPasswords"/><div class="password-tabs"><button id="newPassword" :class="passwordEditor &amp;&amp; !passwordOriginal?'on':''" @click="editPassword(null)">{{ texts.addPasswords }}</button><button id="savedPasswords" :class="passwordScope==='@all' &amp;&amp; !passwordEditor?'on':''" @click="selectScope('@all')">{{ texts.savedPasswords }}</button><button id="clipboardHistory" :class="passwordScope==='@history' &amp;&amp; !passwordEditor?'on':''" @click="selectScope('@history')">{{ texts.history }}</button></div></div>
        <ScrollView id="passwordListScroll"><div id="passwordBody" class="column">
          <div id="passwordForm" v-show="passwordEditor" class="card inline-form" :enabled="!!passwordOriginal||!recordSaving.passwords">
            <div class="row"><label class="subheading">{{ passwordOriginal?texts.editPassword:texts.addPasswords }}</label><div class="spacer"/><button id="closePasswordEditor" @click="leavePassword()">{{ texts.cancelEntries }}</button></div>
              <label class="subheading">{{ texts.passwordText }}</label><input id="passwordValue" v-model="passwordValue"/>
              <div v-show="!passwordOriginal" class="action-row"><label>{{ listCount(passwordValues) }}</label><button id="managePasswords" @click="openList('passwordValues')">{{ texts.manageEntries }}</button></div>
              <label class="subheading">{{ texts.scopeLabel }}</label><div class="action-row"><button id="scopeGlobal" :class="scopeGlobal?'on':''" @click="scopeGlobal=true">{{ texts.allFolders }}</button><button id="scopeSelected" :class="!scopeGlobal?'on':''" @click="scopeGlobal=false">{{ texts.selectedFolders }}</button></div>
              <div v-show="!scopeGlobal" class="column"><div class="action-row"><label>{{ listCount(scopePaths) }}</label><button id="browseScope" @click="send('browse',{target:'scopePaths'})">{{ texts.chooseScope }}</button><button id="manageScopes" @click="openList('scopePaths')">{{ texts.manageEntries }}</button></div><label class="muted collection-preview">{{ listSummary(scopePaths) }}</label><label class="muted">{{ texts.scopeDescription }}</label></div>
              <label v-show="saveErrors['@passwords']" class="error">{{ errorText(saveErrors['@passwords']) }}</label><div class="action-row"><button id="finishPassword" @click="passwordAction('save',passwordOriginal?{}:null)">{{ passwordOriginal?texts.saveEntries:texts.addToList }}</button><button id="deletePassword" v-show="passwordOriginal" @click="passwordAction('delete')">{{ texts.deletePassword }}</button></div>
          </div>
          <div v-show="shownPasswords.length>0" :class="'history-list '+appearance">
            <VirtualList id="passwordItems" v-show="shownPasswords.length>0" style="gap:0px" estimated-height="64px"><div v-for="p in shownPasswords" :key="p.id" :id="'password-'+p.id" class="history-entry">
              <div class="row history-row" :class="'row history-row '+(passwordScope==='@all'?'password-row':'')"><div class="password-copy"><label>{{ p.value }}</label><label v-show="passwordScope==='@all'" class="muted scope-value">{{ texts.scopeLabel }} · {{ p.scopes||texts.allFolders }}</label></div><button v-show="passwordScope==='@history'" class="history-copy" :id="'copy-history-'+p.id" @click="editPassword(p)">{{ texts.copyPassword }}</button><button v-show="passwordScope==='@all'" :id="'edit-password-'+p.id" @click="editPassword(p)">{{ texts.edit }}</button><button v-show="passwordScope==='@all'" :id="'delete-password-'+p.id" :enabled="!recordSaving.passwords" @click="deleteListedPassword(p)">{{ texts.delete }}</button></div>
              <div class="history-divider"/>
            </div>
            </VirtualList>
          </div>
        </div></ScrollView>
      </div>
      <!-- Keep the shell mounted like the existing pages. Nested dynamic
           v-if scopes in this Core UI version can leave duplicate IDs when
           reopening. Clearing the row arrays releases all virtual entries. -->
      <div id="listManager" v-show="listTarget" class="list-manager">
        <div class="row"><label class="heading fill">{{ listTitle }}</label><button id="cancelList" @click="closeList()">{{ texts.cancelEntries }}</button><button id="saveList" @click="saveList()">{{ texts.saveEntries }}</button></div>
        <div v-show="!listImport" class="action-row"><label>{{ listCount(listRows) }}</label><input id="listSearch" type="search" class="fill" :value="listQuery" @input="searchList" :placeholder="texts.searchEntries"/></div>
        <label v-show="listError" class="error">{{ listError }}</label>
        <ScrollView id="listScroll" v-show="!listImport"><VirtualList id="listItems" estimated-height="48px"><div v-for="r in matchingListRows" :key="r.id" :id="'list-row-'+r.id" class="list-row"><label class="list-value">{{ entryLabel(r.value) }}</label><button :id="'edit-list-'+r.id" @click="editListRow(r)">{{ texts.edit }}</button><button :id="'remove-list-'+r.id" @click="removeListRow(r.id)">{{ texts.delete }}</button></div></VirtualList></ScrollView>
        <div v-show="!listImport" class="column"><label>{{ listEditing===-1?texts.newEntry:texts.edit }}</label><input id="listEntry" v-show="!listMultiline" v-model="listEntry" @submit="putListEntry()"/><textarea id="listMultiline" v-show="listMultiline" v-model="listEntry" style="height:90px"/>
          <div class="action-row"><button id="putListEntry" @click="putListEntry()">{{ listEditing===-1?texts.addToList:texts.updateEntry }}</button><button v-show="listTarget==='rootPaths'||listTarget==='scopePaths'" id="browseListEntry" @click="send('browse',{target:'listEntry'})">{{ texts.chooseDirectory }}</button><button v-show="listTarget==='config'||listTarget==='passwordValues'" id="toggleListMultiline" @click="listMultiline=!listMultiline">{{ texts.multilineEntry }}</button><button id="importList" @click="listImport=!listImport">{{ texts.importEntries }}</button></div>
        </div>
        <div v-show="listImport" class="list-import"><label class="muted">{{ texts.importHint }}</label><textarea id="listImportText" v-model="listImportText" @input="v=>{listImportText=v;listPreview=[];}" style="height:100px"/><div class="action-row"><button id="previewImport" @click="previewImport()">{{ texts.previewEntries }}</button><button id="applyImport" :enabled="listPreview.length>0" @click="applyImport()">{{ texts.importEntries }} · {{ listPreview.length }}</button><button id="cancelImport" @click="listImport=false;listImportText='';listPreview=[];listError=''">{{ texts.cancelEntries }}</button></div><ScrollView><VirtualList id="importPreviewItems" estimated-height="28px"><label v-for="r in listPreview" :key="r.id">{{ entryLabel(r.value) }}</label></VirtualList></ScrollView></div>
      </div>
      </div>
    </div>
    <label v-show="closeError" class="error">{{ errorText(closeError) }}</label>
    <div v-show="errorList.length" class="card"><label class="error">{{ texts.fileProblems }}</label><label v-for="e in errorList" :key="e" class="error">{{ e }}</label></div>
    <div v-if="dispatch" id="dispatch" :visible="false" style="position:absolute;left:0px;top:0px;width:0px;height:0px"/>
  </div>
</template>
