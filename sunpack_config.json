{
  "cli": {
    "language": "zh"
  },
  "runtime": {
    "process_mode": "high"
  },
  "recursive_extract": "*",
  "recursive_authorization": {
    "enabled": true
  },
  "embedded_scan": {
    "enabled": true
  },
  "post_extract": {
    "archive_cleanup_mode": "r",
    "flatten_single_directory": true
  },
  "filesystem": {
    "directory_scan_mode": "-",
    "scan_filters_enabled": true,
    "scan_filters": [
      {
        "name": "directory_prune",
        "enabled": true,
        "prune_dir_globs": [
          ".git",
          ".vscode",
          "__pycache__",
          "node_modules",
          "site-packages",
          ".venv",
          "venv",
          "env",
          ".cache",
          "repositories"
        ],
        "path_globs": [
          ".git/**",
          ".vscode/**",
          "$RECYCLE.BIN/**"
        ]
      },
      {
        "name": "whitelist",
        "enabled": false,
        "path_globs": [
          "archives/**",
          "downloads/**"
        ],
        "prune_dir_globs": [
          "archives",
          "downloads"
        ],
        "allowed_files": [
          "sample.zip"
        ],
        "allowed_extensions": [
          ".zip",
          ".zipx",
          ".7z",
          ".rar"
        ]
      },
      {
        "name": "blacklist",
        "enabled": true,
        "blocked_files": [
          "Thumbs.db",
          "desktop.ini"
        ],
        "blocked_extensions": [
          ".dll", ".save", ".py", ".pyc", ".json",
          ".xml", ".cfg", ".ini", ".sys", ".db",
          ".msi", ".cur", ".ani", ".ttf", ".woff",
          ".ico", ".pak", ".obb", ".unitypackage", ".jar",
          ".apk", ".ipa", ".epub", ".odt", ".ods",
          ".odp", ".docx", ".xlsx", ".pptx", ".whl",
          ".xpi", ".war", ".ear", ".aab", ".ckpt",
          ".pt", ".pth", ".safetensors", ".bin", ".dat",
          ".docm", ".xlsm", ".pptm", ".msix", ".msixbundle",
          ".crdownload", ".downloading", ".part", ".win", ".iso"
        ]
      },
      {
        "name": "size_range",
        "enabled": true,
        "min_bytes": 1,
        "max_bytes": null
      },
      {
        "name": "mtime_range",
        "enabled": false,
        "start_utc": null,
        "end_utc": null
      }
    ]
  }
}
