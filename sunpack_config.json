{
  "cli": {
    "language": "zh"
  },
  "runtime": {
    "process_mode": "high"
  },
  "watch": {
    "event_log_retention_days": 7
  },
  "recursive_extract": "*",
  "recursive_authorization": {
    "enabled": true
  },
  "embedded_scan": {
    "enabled": true
  },
  "post_extract": {
    "archive_cleanup_mode": "r",
    "flatten_single_directory": true
  },
  "filesystem": {
    "scan_filters_enabled": true,
    "scan_filters": [
      {
        "name": "blacklist",
        "enabled": true,
        "paths": [
          {
            "value": ".git",
            "regex": false
          },
          {
            "value": ".vscode",
            "regex": false
          },
          {
            "value": "__pycache__",
            "regex": false
          },
          {
            "value": "node_modules",
            "regex": false
          },
          {
            "value": "site-packages",
            "regex": false
          },
          {
            "value": ".venv",
            "regex": false
          },
          {
            "value": "venv",
            "regex": false
          },
          {
            "value": "env",
            "regex": false
          },
          {
            "value": ".cache",
            "regex": false
          },
          {
            "value": "repositories",
            "regex": false
          },
          {
            "value": "$RECYCLE.BIN",
            "regex": false
          }
        ],
        "full_names": [
          {
            "value": "Thumbs.db",
            "regex": false
          },
          {
            "value": "desktop.ini",
            "regex": false
          }
        ],
