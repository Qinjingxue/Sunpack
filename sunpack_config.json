{
  "cli": {
    "language": "zh"
  },
  "runtime": {
    "process_mode": "high"
  },
  "watch": {
    "event_log_retention_days": 7
  },
  "recursive_extract": "*",
  "recursive_authorization": {
    "enabled": true
  },
  "embedded_scan": {
    "enabled": true
  },
  "post_extract": {
    "archive_cleanup_mode": "r",
    "flatten_single_directory": true
  },
  "filesystem": {
    "scan_filters_enabled": true,
    "scan_filters": [
      {
        "name": "blacklist",
        "enabled": true,
        "paths": [
          {
            "value": ".git",
            "regex": false
          },
          {
            "value": ".vscode",
            "regex": false
          },
          {
            "value": "__pycache__",
            "regex": false
          },
          {
            "value": "node_modules",
            "regex": false
          },
          {
            "value": "site-packages",
            "regex": false
          },
          {
            "value": ".venv",
            "regex": false
          },
          {
            "value": "venv",
            "regex": false
          },
          {
            "value": "env",
            "regex": false
          },
          {
            "value": ".cache",
            "regex": false
          },
          {
            "value": "repositories",
            "regex": false
          },
          {
            "value": "$RECYCLE.BIN",
            "regex": false
          }
        ],
        "files": [
          {
            "value": "Thumbs.db",
            "regex": false
          },
          {
            "value": "desktop.ini",
            "regex": false
          },
          {
            "value": "\\.(?:dll|save|py|pyc|json|xml|cfg|ini|sys|db|msi|cur|ani|ttf|woff|ico|pak|obb|unitypackage|jar|apk|ipa|epub|odt|ods|odp|docx|xlsx|pptx|whl|xpi|war|ear|aab|ckpt|pt|pth|safetensors|bin|dat|docm|xlsm|pptm|msix|msixbundle|crdownload|downloading|part|win|iso|tmp)\\z",
            "regex": true
          }
        ]
      },
      {
        "name": "whitelist",
        "enabled": false,
        "paths": [
          {
            "value": "archives",
            "regex": false
          },
          {
            "value": "downloads",
            "regex": false
          }
        ],
        "files": [
          {
            "value": "\\.(?:zip|zipx|7z|rar)\\z",
            "regex": true
          }
        ]
      },
      {
        "name": "size_range",
        "enabled": true,
        "min_bytes": 1,
        "max_bytes": null
      },
      {
        "name": "mtime_range",
        "enabled": false,
        "start_utc": null,
        "end_utc": null
      }
    ]
  }
}
