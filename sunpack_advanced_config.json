      "space_status_report_interval_ms": 15000
    }
  },
  "runtime": {
    "process_mode": "normal"
  },
  "watch": {
    "boundary_confirmation_seconds": 0.5,
    "runtime_cache_cleanup_idle_seconds": 10,
    "clipboard_monitor_enabled": true,
    "clipboard_builtin_max_entries": 30,
    "tray_enabled": true,
