{
  "cli": {
    "language": "zh"
  },
  "recursive_extract": "*",
  "nested_extraction_policy": {
    "enabled": true,
    "byte_ratio_exponent": 1,
    "project_ratio_exponent": 1,
    "authorization_bias": 0,
    "minimum_authorization_score": 0.85,
    "minimum_archive_byte_ratio": 0.1,
    "hard_maximum_other_projects": 1000
  },
  "post_extract": {
    "archive_cleanup_mode": "r",
    "flatten_single_directory": true
  },
  "filesystem": {
    "directory_scan_mode": "-",
    "scan_filters_enabled": true,
    "scan_filters": [
      {
        "name": "directory_prune",
        "enabled": true,
        "prune_dir_globs": [
          ".git", ".vscode", "__pycache__", "node_modules", "site-packages", ".venv", "venv", "env", ".cache",
          "repositories"
        ],
        "path_globs": [".git/**", ".vscode/**", "$RECYCLE.BIN/**"]
      },
      {
        "name": "whitelist",
        "enabled": false,
        "path_globs": ["archives/**", "downloads/**"],
        "prune_dir_globs": ["archives", "downloads"],
        "allowed_files": ["sample.zip"],
        "allowed_extensions": [".zip", ".7z", ".rar"]
      },
      {
        "name": "blacklist",
        "enabled": true,
        "blocked_files": ["Thumbs.db", "desktop.ini"],
        "blocked_extensions": [
          ".dll", ".save", ".py", ".pyc", ".json", ".xml", ".cfg", ".ini", ".sys", ".db", ".msi", ".cur",
          ".ani", ".ttf", ".woff", ".ico", ".pak", ".obb", ".unitypackage", ".jar", ".apk", ".ipa", ".epub",
          ".odt", ".ods", ".odp", ".docx", ".xlsx", ".pptx", ".whl", ".xpi", ".war", ".ear", ".aab", ".ckpt",
          ".pt", ".pth", ".safetensors", ".bin", ".dat", ".docm", ".xlsm", ".pptm"
        ]
      },
      {
        "name": "size_range",
        "enabled": true,
        "range": "r >= 1 MB"
      },
      {
        "name": "mtime_range",
        "enabled": false,
        "date": "20270101 00:00 > d >= 20240101 00:00"
      }
    ]
  },
  "performance": {
    "precise_resource_min_size_mb": 256,
    "persistent_server_idle_seconds": 15,
    "worker": {
      "exploration_strategy": "calibrated",
      "resource_diagnostics_enabled": false,
      "minimum_window_seconds": 0.25,
      "maximum_window_seconds": 1.5,
      "settle_seconds": 0.1,
      "large_window_bytes": 33554432,
      "small_window_jobs": 4,
      "small_window_files": 16,
      "improvement_ratio": 1.03,
      "regression_ratio": 0.97,
      "aggressive_step": 4,
      "cooldown_windows": 2,
      "hold_windows": 8,
      "warm_start_decay_seconds": 0.0,
      "warm_start_confirmations": 2,
      "watchdog_no_progress_timeout_seconds": 180,
      "thread_capacity": 0,
      "stage_thread_capacity": 0,
      "max_inflight_files": 0,
      "max_pending_stage_jobs": 4096,
      "adaptive_enabled": true,
      "initial_active_jobs": 0,
      "sample_interval_ms": 500,
      "max_queue_jobs": 4096,
      "priority_aging_quantum": 32,
      "backpressure_retries": 120,
      "writer_threads": 4,
      "memory_budget_bytes": 0,
      "job_buffer_budget_bytes": 33554432,
      "memory_pause_available_mb": 1024,
      "memory_resume_available_mb": 2048,
      "space_gate_enabled": true,
      "space_poll_interval_ms": 1000,
      "space_status_report_interval_ms": 15000
    },
    "resource_guard": {
      "enabled": false,
      "max_file_count": 0,
      "max_total_unpacked_size": 0,
      "max_largest_item_size": 0,
      "max_compression_ratio": 0
    }
  },
  "watch": {
    "cold_start_seconds": 0.0,
    "quiet_min_seconds": 0.0,
    "quiet_max_seconds": 180.0,
    "boundary_confirmation_seconds": 0.5,
    "max_folders": 16,
    "observer_stop_timeout_seconds": 5.0,
    "runtime_cache_cleanup_enabled": true,
    "runtime_cache_cleanup_idle_seconds": 10.0,
    "password_retry_debounce_seconds": 0.5,
    "password_retry_include_subtree": true,
    "clipboard_monitor_enabled": true,
    "clipboard_builtin_max_entries": 30,
    "enabled": false,
    "roots": [],
    "out_dir": ".",
    "tray_enabled": true,
    "toast_enabled": true,
    "toast_update_interval_ms": 50,
    "toast_completion_debounce_ms": 800,
    "toast_success_ttl_seconds": 3.0,
    "toast_failure_ttl_seconds": 5.0,
    "toast_report_retention_days": 30,
    "toast_report_max_files": 256,
    "toast_report_max_bytes": 16777216,
    "state_dir": ""
  },
  "passwords": {
    "clipboard_passwords_enabled": true,
    "directory_passwords_enabled": true,
    "directory_passwords_max_file_bytes": 1048576,
    "directory_passwords_max_password_length": 512
  },
  "extraction": {
    "write_progress_manifest": false,
    "content_requirement": "complete"
  },
  "embedded_scan": {
    "enabled": true
  },
  "input_planning": {
    "enabled": true,
    "cache_size": 512
  },
  "analysis": {
    "max_concurrent_reads": 1,
    "shared_cache_mb": 64,
    "max_read_mb_per_archive": 256,
    "prepass": {
      "enabled": true,
      "head_bytes": 1048576,
      "tail_bytes": 1048576
    },
    "fuzzy": {
      "enabled": true,
      "modules": [
        {
          "name": "binary_profile",
          "enabled": true,
          "window_bytes": 65536,
          "max_windows": 8,
          "max_sample_bytes": 1048576,
          "entropy_high_threshold": 6.8,
          "entropy_low_threshold": 3.5,
          "entropy_jump_threshold": 1.25,
          "ngram_top_k": 8,
          "max_ngram_sample_bytes": 262144
        }
      ]
    },
    "thresholds": {
      "extractable_confidence": 0.85
    },
    "modules": [
      {
        "name": "zip",
        "enabled": true,
        "max_cd_entries_to_walk": 64
      },
      {
        "name": "rar",
        "enabled": true,
        "max_blocks_to_walk": 4096
      },
      {
        "name": "seven_zip",
        "enabled": true,
        "max_next_header_check_bytes": 1048576
      },
      {
        "name": "tar",
        "enabled": true,
        "max_entries_to_walk": 64
      },
      {
        "name": "gzip",
        "enabled": true,
        "max_probe_bytes": 4194304
      },
      {
        "name": "bzip2",
        "enabled": true,
        "max_probe_bytes": 4194304
      },
      {
        "name": "xz",
        "enabled": true,
        "max_probe_bytes": 4194304
      },
      {
        "name": "zstd",
        "enabled": true,
        "max_probe_bytes": 4194304
      },
      {
        "name": "tar_gz",
        "enabled": true,
        "max_probe_bytes": 4194304
      },
      {
        "name": "tar_bz2",
        "enabled": true,
        "max_probe_bytes": 4194304
      },
      {
        "name": "tar_xz",
        "enabled": true,
        "max_probe_bytes": 4194304
      },
      {
        "name": "tar_zst",
        "enabled": true,
        "max_probe_bytes": 4194304
      }
    ]
  },
  "verification": {
    "enabled": true,
    "max_retries": 2,
    "cleanup_failed_output": true,
    "complete_accept_threshold": 0.999,
    "partial_accept_threshold": 0.2,
    "retry_on_verification_failure": true,
    "methods": [
      {
        "name": "extraction_exit_signal",
        "enabled": true
      },
      {
        "name": "output_presence",
        "enabled": true
      },
      {
        "name": "expected_name_presence",
        "enabled": true,
        "max_expected_names": 50,
        "required_match_ratio": 0.8,
        "minor_missing_penalty": 10,
        "missing_penalty": 35,
        "all_missing_penalty": 60
      },
      {
        "name": "manifest_size_match",
        "enabled": true,
        "max_expected_names": 2000,
        "file_count_abs_tolerance": 2,
        "file_count_ratio_tolerance": 0.05,
        "size_abs_tolerance_bytes": 1048576,
        "size_ratio_tolerance": 0.02
      },
      {
        "name": "archive_test_crc",
        "enabled": true,
        "max_items": 200000,
        "max_reported_items": 20
      },
      {
        "name": "sample_readability",
        "enabled": true,
        "max_samples": 64,
        "read_bytes": 4096,
        "max_reported_items": 20
      }
    ]
  },
  "detection": {
    "enabled": true,
    "fact_collectors": [
      {
        "name": "file_facts",
        "enabled": true
      },
      {
        "name": "magic_bytes",
        "enabled": true
      }
    ],
    "processors": [
      {
        "name": "embedded_archive",
        "enabled": true
      },
      {
        "name": "zip_structure",
        "enabled": true
      },
      {
        "name": "zip_eocd_structure",
        "enabled": true
      },
      {
        "name": "tar_header_structure",
        "enabled": true
      },
      {
        "name": "compression_stream_structure",
        "enabled": true
      },
      {
        "name": "pe_overlay_structure",
        "enabled": true
      },
      {
        "name": "executable_carrier",
        "enabled": true,
        "scan_limit_bytes": 8388608
      },
      {
        "name": "seven_zip_structure",
        "enabled": true
      },
      {
        "name": "rar_structure",
        "enabled": true
      }
    ],
    "rule_pipeline": {
      "precheck": [
        {
          "name": "zip_structure_accept",
          "enabled": true,
          "accept_empty_zip": true
        },
        {
          "name": "tar_structure_accept",
          "enabled": true
        },
        {
          "name": "seven_zip_structure_accept",
          "enabled": true,
          "max_next_header_check_bytes": 1048576
        },
        {
          "name": "rar_structure_accept",
          "enabled": true,
          "max_first_header_check_bytes": 1048576
        },
        {
          "name": "compression_stream_accept",
          "enabled": true
        },
        {
          "name": "embedded_payload_identity",
          "enabled": true,
          "deep_scan_single_candidate_ratio": 0.3
        }
      ]
    }
  }
}
